classDiagram
    class Task {
        +str title
        +str time
        +int duration_minutes
        +str priority
        +str recurrence
        +date due_date
        +bool completed
        +str pet_name
        +str notes
        +start_minutes int
        +end_minutes int
        +mark_completed() Task
    }
    class Pet {
        +str name
        +str species
        +int age
        +list~Task~ tasks
        +add_task(task) void
        +get_tasks(include_completed) list
    }
    class Owner {
        +str name
        +list~Pet~ pets
        +add_pet(pet) void
        +get_all_tasks(include_completed) list
        +find_pet(name) Pet
    }
    class Scheduler {
        +Owner owner
        +get_schedule(for_date, pet_name, completed) list~Task~
        +find_conflicts(for_date) list
        +complete_task(task) Task
        +explain_schedule(tasks) str
    }
    Owner "1" o-- "0..*" Pet : manages
    Pet "1" o-- "0..*" Task : has
    Scheduler --> Owner : reads tasks from
    Scheduler ..> Task : schedules and completes
